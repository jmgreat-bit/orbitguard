# Copy this file to `.env` and fill in your own key.
# Get a free Gemini API key at https://aistudio.google.com/apikey
#
# `.env` is gitignored — never commit your real key.
#
# Without a key the simulator still runs: the FlightController falls back to
# its deterministic safety rules instead of the Gemini planner.

VITE_GEMINI_API_KEY=your_api_key_here
