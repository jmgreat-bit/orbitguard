# Copy this file to `.env` and fill in what you have. `.env` is gitignored.
#
# These are read by the local Vite server only (vite.config.js → server/api.js).
# They are NOT prefixed with VITE_, so they are never compiled into the browser code.

# Gemini planner. Free key: https://aistudio.google.com/apikey
# Without it the rule-based autopilot flies the satellite.
GEMINI_API_KEY=

# Optional: which Gemini model to use (default gemini-3.5-flash).
# gemini-2.5-flash was scheduled to shut down on the Gemini API on 16 Oct 2026.
GEMINI_MODEL=

# Optional: your NASA API key for DONKI solar-flare data (https://api.nasa.gov).
# Without it the shared DEMO_KEY is used, which is heavily rate-limited.
NASA_API_KEY=
